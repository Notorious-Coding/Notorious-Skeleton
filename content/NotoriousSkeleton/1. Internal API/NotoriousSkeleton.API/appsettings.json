{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Build": {
    "Version": "OVERWRITTEN_BY_DEPLOY",
    "Branch": "OVERWRITTEN_BY_DEPLOY",
    "CommitSha": "OVERWRITTEN_BY_DEPLOY"
  },
  "CORS": {
    "AllowedOrigins": "OVERWRITTEN_BY_DEPLOY"
  },
  "ConnectionStrings": {
    "Catalog": "OVERWRITTEN_BY_DEPLOY",
    "Ordering": "OVERWRITTEN_BY_DEPLOY"
  },
  "ClientCredentialAuthentication": {
    "Authority": "OVERWRITTEN_BY_DEPLOY",
    "Audience": "OVERWRITTEN_BY_DEPLOY"
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/notoriousskeleton.ndjson",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
