# .editorconfig
root = true

[*.cs]

###############
# Namespaces  #
###############
# Préférer les namespaces "file-scoped" (namespace X.Y;)
csharp_style_namespace_declarations = file_scoped:warning
# S'assure que l'analyseur affiche bien un diagnostic dédié
dotnet_diagnostic.IDE0161.severity = warning

############################
# Naming rules (C# fields) #
############################
# Règle : les champs privés -> _camelCase
dotnet_naming_rule.private_fields_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_with_underscore.style   = underscore_prefix_camel_case
dotnet_naming_rule.private_fields_with_underscore.severity = warning

# Symboles visés par la règle ci-dessus : champs privés
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

# Style : préfixe "_" + camelCase
dotnet_naming_style.underscore_prefix_camel_case.required_prefix = _
dotnet_naming_style.underscore_prefix_camel_case.capitalization = camel_case